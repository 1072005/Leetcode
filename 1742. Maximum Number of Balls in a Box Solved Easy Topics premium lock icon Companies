using System;
public class Solution {
    public int CountBalls(int lowLimit, int highLimit) {
                int[] count = new int[46];
        int ans = 0;
        for (int i = lowLimit; i <= highLimit; i++) {
            int sum = 0;
            for (int j = i; j > 0; j /= 10) {
                sum += j % 10;
            }
            count[sum]++;
            ans = Math.Max(ans, count[sum]);
        }
        return ans;
    }
}
