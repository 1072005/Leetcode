public class Solution {
    public int ClimbStairs(int n) {
        int Ans=0;
        int Record_1=2;
        int Record_2=1;
        if(n==1)
        {
            return 1;
        }
        else if(n==2)
        {
            return 2;
        }
        else
        {
            for(int i=3;i<=n;i++)
            {
                Ans=Record_1+Record_2;
                Record_2=Record_1;
                Record_1=Ans;
            }
            return Ans;
        }

    }

}
